---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Set on pages that render content derived from the Wikipedia outline. */
  derived?: boolean;
}

const { title, description, derived = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const nav = [
  { href: '/', label: 'Start' },
  { href: '/rules', label: 'Filing rules' },
  { href: '/core', label: 'Core disciplines' },
  { href: '/extending', label: 'Extend it' },
  { href: '/extensions', label: 'My extensions' },
  { href: '/find', label: 'Find one' },
  { href: '/outline', label: 'Outline' },
  { href: '/hubs', label: 'Hubs' },
  { href: '/colophon', label: 'Colophon' },
];
const here = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title} — Antinet Manual</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical.href} />
    <link rel="sitemap" href={`${base}/sitemap-index.xml`} />
    <link
      rel="icon"
      href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'><text y='14' font-size='14'>🗂️</text></svg>"
    />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site">
      <div class="page bar">
        <a class="wordmark" href={`${base}/`}>
          <span class="ad mark">1000</span>
          <span>Antinet Manual</span>
        </a>
        <nav aria-label="Primary">
          <ul>
            {
              nav.map((item) => (
                <li>
                  <a
                    href={`${base}${item.href === '/' ? '/' : item.href}`}
                    aria-current={here === item.href ? 'page' : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>

    <main id="main" class="page">
      <slot />
    </main>

    <p class="vh" id="copy-status" role="status" aria-live="polite"></p>

    <footer class="site">
      <div class="page">
        <p>
          A living implementation manual for the Antinet Zettelkasten — the practical
          questions, answered in one place.
        </p>
        <p class="repo">
          Written in the open:{' '}
          <a href="https://github.com/adilsoncarvalho/zettelkasten.adilsoncarvalho.com"
            >the source for this site is on GitHub</a
          >.
        </p>
        <p class="attr">
          © 2026 Adilson Carvalho. The numbering scheme, the filing rules and all prose are
          original work, licensed{' '}
          <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/">CC BY-NC-SA 4.0</a> —
          reuse with attribution, non-commercially. <a href={`${base}/colophon#licensing`}
            >What is covered by what</a
          >.
        </p>
        {
          derived && (
            <p class="attr">
              The address-and-name listings on this page are adapted from{' '}
              <a href="https://en.wikipedia.org/wiki/Outline_of_academic_disciplines">
                Outline of academic disciplines
              </a>{' '}
              (Wikipedia), retrieved 2026-08-17, and are licensed{' '}
              <a href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a>. That
              obligation attaches to those listings, not to the surrounding prose or to the
              scheme itself.
            </p>
          )
        }
      </div>
    </footer>

    <style>
      .skip {
        position: absolute;
        left: -9999px;
        background: var(--surface);
        color: var(--ink);
        padding: 0.6rem 1rem;
        z-index: 10;
      }
      .skip:focus {
        left: 1rem;
        top: 1rem;
      }
      header.site {
        border-bottom: 1px solid var(--rule);
        background: var(--ground);
        position: sticky;
        top: 0;
        z-index: 5;
      }
      .bar {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        justify-content: space-between;
        gap: 0.5rem 1.5rem;
        padding-top: 0.9rem;
        padding-bottom: 0.9rem;
      }
      .wordmark {
        display: flex;
        align-items: baseline;
        gap: 0.55rem;
        text-decoration: none;
        color: var(--ink);
        font: 600 1rem var(--serif);
      }
      .mark {
        font-size: 0.8rem;
        font-weight: 600;
      }
      nav ul {
        display: flex;
        flex-wrap: wrap;
        gap: 0.15rem 1.1rem;
        list-style: none;
        margin: 0;
        padding: 0;
      }
      nav li {
        max-width: none;
      }
      nav a {
        text-decoration: none;
        color: var(--muted);
        font-size: 0.89rem;
      }
      nav a:hover {
        color: var(--ink);
      }
      nav a[aria-current='page'] {
        color: var(--brass);
        font-weight: 600;
      }
      main {
        padding-bottom: 5rem;
      }
      footer.site {
        border-top: 1px solid var(--rule);
        padding: 2rem 0 3rem;
        color: var(--muted);
        font-size: 0.85rem;
      }
      footer p {
        max-width: var(--measure);
      }
      .repo {
        margin-top: 0.5rem;
      }
      .attr {
        margin-top: 0.8rem;
        padding-top: 0.8rem;
        border-top: 1px solid var(--rule);
        font-size: 0.8rem;
      }
    </style>

    <script is:inline>
      (() => {
        // Copying is the whole action: the click is cancelled, so the page never
        // jumps to the fragment it just copied. The address bar is updated by
        // replaceState instead — no scroll, no history entry — which leaves the
        // URL somewhere the reader can still take it from when the clipboard
        // refuses (denied permission, insecure context).
        const status = document.getElementById('copy-status');
        let shown = null;
        let timer;

        const reset = () => {
          if (shown) shown.removeAttribute('data-copied');
          shown = null;
          status.textContent = '';
        };

        document.addEventListener('click', (event) => {
          if (!event.target.closest) return;
          const heading = event.target.closest('.linked');
          const link = heading && heading.querySelector('a.hlink');
          if (!link) return;

          // A heading can carry a link of its own — a division code pointing at
          // /core. That link keeps its own behaviour.
          const inside = event.target.closest('a');
          if (inside && inside !== link) return;

          // A modified click on the icon stays the browser's, so it can still be
          // opened in a new tab or copied as a link address.
          if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

          // Dragging a selection out of the heading ends in a click here. Copying
          // then would overwrite the words the reader is about to take.
          const selection = window.getSelection();
          if (selection && !selection.isCollapsed) return;

          event.preventDefault();
          const href = link.getAttribute('href');
          if (location.hash !== href) history.replaceState(null, '', href);
          if (!navigator.clipboard) return;

          // link.href is the resolved absolute URL, fragment included.
          navigator.clipboard.writeText(link.href).then(() => {
            clearTimeout(timer);
            reset();
            heading.setAttribute('data-copied', '');
            shown = heading;
            status.textContent = 'Link copied';
            timer = setTimeout(reset, 1600);
          }, reset);
        });
      })();
    </script>
  </body>
</html>
