---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Set on pages that render content derived from the Wikipedia outline. */
  derived?: boolean;
}

const { title, description, derived = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const nav = [
  { href: '/', label: 'Start' },
  { href: '/rules', label: 'Filing rules' },
  { href: '/core', label: 'Core disciplines' },
  { href: '/extending', label: 'Extend it' },
  { href: '/extensions', label: 'My extensions' },
  { href: '/find', label: 'Find one' },
  { href: '/outline', label: 'Outline' },
  { href: '/hubs', label: 'Hubs' },
  { href: '/colophon', label: 'Colophon' },
];
const here = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title} — Antinet Manual</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical.href} />
    <link rel="sitemap" href={`${base}/sitemap-index.xml`} />
    <link
      rel="icon"
      href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'><text y='14' font-size='14'>🗂️</text></svg>"
    />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site">
      <div class="page bar">
        <a class="wordmark" href={`${base}/`}>
          <span class="ad mark">1000</span>
          <span>Antinet Manual</span>
        </a>
        <nav aria-label="Primary">
          <ul>
            {
              nav.map((item) => (
                <li>
                  <a
                    href={`${base}${item.href === '/' ? '/' : item.href}`}
                    aria-current={here === item.href ? 'page' : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>

    <main id="main" class="page">
      <slot />
    </main>

    <footer class="site">
      <div class="page">
        <p>
          A living implementation manual for the Antinet Zettelkasten — the practical
          questions, answered in one place.
        </p>
        <p class="attr">
          © 2026 Adilson Carvalho. The numbering scheme, the filing rules and all prose are
          original work, licensed{' '}
          <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/">CC BY-NC-SA 4.0</a> —
          reuse with attribution, non-commercially. <a href={`${base}/colophon#licensing`}
            >What is covered by what</a
          >.
        </p>
        {
          derived && (
            <p class="attr">
              The address-and-name listings on this page are adapted from{' '}
              <a href="https://en.wikipedia.org/wiki/Outline_of_academic_disciplines">
                Outline of academic disciplines
              </a>{' '}
              (Wikipedia), retrieved 2026-08-17, and are licensed{' '}
              <a href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a>. That
              obligation attaches to those listings, not to the surrounding prose or to the
              scheme itself.
            </p>
          )
        }
      </div>
    </footer>

    <style>
      .skip {
        position: absolute;
        left: -9999px;
        background: var(--surface);
        color: var(--ink);
        padding: 0.6rem 1rem;
        z-index: 10;
      }
      .skip:focus {
        left: 1rem;
        top: 1rem;
      }
      header.site {
        border-bottom: 1px solid var(--rule);
        background: var(--ground);
        position: sticky;
        top: 0;
        z-index: 5;
      }
      .bar {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        justify-content: space-between;
        gap: 0.5rem 1.5rem;
        padding-top: 0.9rem;
        padding-bottom: 0.9rem;
      }
      .wordmark {
        display: flex;
        align-items: baseline;
        gap: 0.55rem;
        text-decoration: none;
        color: var(--ink);
        font: 600 1rem var(--serif);
      }
      .mark {
        font-size: 0.8rem;
        font-weight: 600;
      }
      nav ul {
        display: flex;
        flex-wrap: wrap;
        gap: 0.15rem 1.1rem;
        list-style: none;
        margin: 0;
        padding: 0;
      }
      nav li {
        max-width: none;
      }
      nav a {
        text-decoration: none;
        color: var(--muted);
        font-size: 0.89rem;
      }
      nav a:hover {
        color: var(--ink);
      }
      nav a[aria-current='page'] {
        color: var(--brass);
        font-weight: 600;
      }
      main {
        padding-bottom: 5rem;
      }
      footer.site {
        border-top: 1px solid var(--rule);
        padding: 2rem 0 3rem;
        color: var(--muted);
        font-size: 0.85rem;
      }
      footer p {
        max-width: var(--measure);
      }
      .attr {
        margin-top: 0.8rem;
        padding-top: 0.8rem;
        border-top: 1px solid var(--rule);
        font-size: 0.8rem;
      }
    </style>
  </body>
</html>
